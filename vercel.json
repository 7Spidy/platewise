{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30
    },
    "api/public/[...slug].js": {
      "maxDuration": 10
    },
    "api/me/[...slug].js": {
      "maxDuration": 10
    },
    "api/admin/[...slug].js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
