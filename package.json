{
  "name": "platewise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@vercel/blob": "^0.27.1",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
