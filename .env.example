# Anthropic
ANTHROPIC_API_KEY=

# App-level passcode lock (V2)
APP_PASSCODE=1234
SESSION_SECRET=replace-with-a-long-random-string

# Vercel Postgres — auto-filled by `vercel env pull` once you add the integration
POSTGRES_URL=

# Vercel Blob — auto-filled by `vercel env pull` once you add the integration
BLOB_READ_WRITE_TOKEN=

# Local dev server port (optional, defaults to 3001)
PORT=3001
