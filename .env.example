ANTHROPIC_API_KEY=your-api-key-here

# Auth
SESSION_SECRET=your-session-secret-here-min-32-chars
ADMIN_PASSCODE=your-admin-passcode-here

# Database (Vercel Postgres)
POSTGRES_URL=your-postgres-url-here
POSTGRES_URL_NON_POOLING=your-postgres-url-non-pooling-here

# Blob storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# Email (Resend)
RESEND_API_KEY=your-resend-api-key-here

# App URL (for email links)
APP_BASE_URL=http://localhost:5173

# Optional: USD to INR conversion rate for cost display (default: 94.7)
# ANTHROPIC_USD_INR_RATE=94.7

# Local dev only — skip TLS verification when behind a corporate
# inspecting proxy that re-signs the cert chain to api.anthropic.com.
# DO NOT set this in production. Remove or leave blank when deploying.
# NODE_TLS_REJECT_UNAUTHORIZED=0
